# Docker Compose 必填项：请复制为 .env 后填写，勿将 .env 提交到 Git。
MYSQL_ROOT_PASSWORD=
ADMIN_PASSWORD=

# 可选集成
ADMIN_PHONE=13800138000
DEEPSEEK_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# Hardhat RPC 默认只绑定本机。远程客户端请通过受控的 HTTPS RPC 代理访问。
RPC_URL=http://127.0.0.1:8545
CHAIN_BACKEND=hardhat
ORACLE_PRIVATE_KEY=
CONTRACT_ADDRESS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=guardian_db
HOST=127.0.0.1
PORT=3000
VITE_RPC_URL=http://localhost:8545
# FISCO BCOS 本地测试链时设为 fisco，跳过 Hardhat 测试账户自动充值。
VITE_CHAIN_BACKEND=hardhat
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,null
