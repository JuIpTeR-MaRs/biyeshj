# Docker Compose 必填项：请复制为 .env 后填写，勿将 .env 提交到 Git。
MYSQL_ROOT_PASSWORD=
ADMIN_PASSWORD=

# 可选集成
ADMIN_PHONE=13800138000
DEEPSEEK_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# Hardhat RPC 默认只绑定本机。远程客户端请通过受控的 HTTPS RPC 代理访问。
VITE_RPC_URL=http://localhost:8545
CORS_ORIGINS=http://localhost:8080
