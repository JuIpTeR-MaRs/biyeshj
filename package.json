{
  "name": "biyesheji",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:contract": "npx hardhat test test/GuardianDApp.test.cjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e:pc": "playwright test",
    "test:e2e:android": "wdio run wdio.android.conf.js",
    "deploy": "npx hardhat run scripts/deploy.cjs --network localhost",
    "seed": "npx hardhat run scripts/seed-demo.cjs --network localhost",
    "node": "npx hardhat node --hostname 0.0.0.0",
    "mock:start": "node mock-server/index.js",
    "app": "electron .",
    "app:ward": "electron . --session=ward",
    "app:guardian": "electron . --session=guardian",
    "app:dist": "vite build && electron-builder",
    "cap:sync": "vite build && cap sync",
    "cap:android": "cap open android"
  },
  "build": {
    "appId": "com.guardiandapp.bank",
    "productName": "GuardianDApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@openzeppelin/contracts": "^5.6.1",
    "alipay-sdk": "^4.14.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "lucide-react": "^0.378.0",
    "mysql2": "^3.22.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^10.0.5",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.1.1",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@wdio/appium-service": "^9.31.7",
    "@wdio/cli": "^9.31.7",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "autoprefixer": "^10.4.19",
    "electron": "^42.0.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.0.0",
    "hardhat": "^2.22.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
